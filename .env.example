DATABASE_URL=postgresql://lumberjack:lumberjack@localhost:5433/lumberjack
# Login password and session signing secret (v1 uses the same value for both).
# Production requires >=12 chars and rejects defaults like changeme.
AUTH_PASSWORD=changeme
# Local only. Production refuses to boot with AUTH_DISABLED=1.
AUTH_DISABLED=1
WA_AUTH_DIR=./data/wa-auth
