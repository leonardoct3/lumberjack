generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SenderRole {
  admin
  pista
  unknown
}

enum MessageClass {
  admin_promo
  pista_oferta
  pista_procura
  ruido
}

enum CandidateStatus {
  pending
  confirmed
  rejected
}

enum PartyStatus {
  upcoming
  past
  cancelled
}

enum Platform {
  sympla
  gandaya
  blacktag
  ingresse
  other
  unknown
}

enum SignalType {
  offer
  demand
}

model Group {
  id        String    @id @default(cuid())
  waId      String    @unique
  name      String
  listen    Boolean   @default(false)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Sender {
  id        String     @id @default(cuid())
  waId      String     @unique
  name      String?
  role      SenderRole @default(unknown)
  messages  Message[]
  signals   Signal[]
  createdAt DateTime   @default(now())

  /**
   * Operator silenced this sender: messages are still stored for the audit
   * trail, but they never open a candidate or a signal. For the promoters whose
   * posts are weekly agendas and guest lists, never a festa worth cataloguing.
   */
  muted     Boolean    @default(false)
}

model Message {
  id           String         @id @default(cuid())
  waMessageId  String         @unique
  group        Group          @relation(fields: [groupId], references: [id])
  groupId      String
  sender       Sender         @relation(fields: [senderId], references: [id])
  senderId     String
  sentAt       DateTime
  text         String
  class        MessageClass?
  party        Party?   @relation(fields: [partyId], references: [id])
  partyId      String?
  /** A promoter blast announces a whole season, so one message, many festas. */
  candidates   PartyCandidate[]
  signals      Signal[]
  createdAt    DateTime @default(now())

  processingJobs     ProcessingJob[]
  interpretationRuns InterpretationRun[]
  observations       Observation[]
  resolutions        ResolutionProposal[]
  reviews            ProposalReview[]

  /** Operator sent this orphan away without linking it; keeps the Inbox drainable. */
  dismissedAt  DateTime?

  /** Body identity used to collapse the same text cross-posted to many groups. */
  fingerprint   String?
  /** Set on every copy after the first; the first occurrence stays canonical. */
  duplicateOf   Message?  @relation("MessageDuplicates", fields: [duplicateOfId], references: [id])
  duplicateOfId String?
  duplicates    Message[] @relation("MessageDuplicates")

  @@index([senderId, fingerprint, sentAt])
  @@index([duplicateOfId])
}

model PartyCandidate {
  id              String          @id @default(cuid())
  status          CandidateStatus @default(pending)
  name            String?
  url             String?
  lotLabel        String?
  officialPrice   Float?
  eventAt         DateTime?
  platform        Platform        @default(unknown)
  source          Message         @relation(fields: [sourceMessageId], references: [id])
  sourceMessageId String
  createdAt       DateTime        @default(now())

  /**
   * The lines of the source message this candidate was read from, for the blasts
   * that announce several festas at once. Null when the whole message is the
   * excerpt, which is every message written about one festa.
   */
  excerpt         String?

  @@index([sourceMessageId])
}

model Party {
  id                 String         @id @default(cuid())
  name               String
  aliases            String[]
  eventAt            DateTime
  status             PartyStatus    @default(upcoming)
  qualitativeScore   Int?
  watchlistPosition  Int?
  notes              String?
  lots               Lot[]
  messages           Message[]
  signals            Signal[]
  heatSnapshots      HeatSnapshot[]
  createdAt          DateTime       @default(now())
}

model Lot {
  id            String    @id @default(cuid())
  party         Party     @relation(fields: [partyId], references: [id])
  partyId       String
  label         String
  openedAt      DateTime
  closedAt      DateTime?
  officialPrice Float?
  url           String?
  platform      Platform  @default(unknown)
}

model Signal {
  id        String     @id @default(cuid())
  type      SignalType
  party     Party      @relation(fields: [partyId], references: [id])
  partyId   String
  message   Message    @relation(fields: [messageId], references: [id])
  messageId String     @unique
  sender    Sender     @relation(fields: [senderId], references: [id])
  senderId  String
  createdAt DateTime   @default(now())
}

model HeatSnapshot {
  id                      String   @id @default(cuid())
  party                   Party    @relation(fields: [partyId], references: [id])
  partyId                 String
  computedAt              DateTime
  demand1d                Int
  demand3d                Int
  demand7d                Int
  offer1d                 Int
  offer3d                 Int
  offer7d                 Int
  daysToEvent             Int

  /**
   * People, not messages. One person asking five times is one buyer, which is
   * also what makes cross-posting harmless without deduplicating anything.
   */
  uniqueDemandSenders1d   Int      @default(0)
  uniqueDemandSenders3d   Int      @default(0)
  uniqueDemandSenders7d   Int
  uniqueOfferSenders1d    Int      @default(0)
  uniqueOfferSenders3d    Int      @default(0)
  uniqueOfferSenders7d    Int      @default(0)
}

enum WaState {
  connected
  qr
  disconnected
}

enum ProcessingStage {
  interpret
  resolve
}

enum JobStatus {
  pending
  running
  succeeded
  dead
}

/** Why a job or run failed; unresolved ambiguity is a result, never a failure. */
enum FailureKind {
  transient
  timeout
  schema
  refusal
  budget
  internal
}

enum RunStatus {
  succeeded
  failed
}

enum ObservationIntent {
  demand
  offer
  promotion
  update
  withdrawal_claim
  unrelated
  unresolved
}

/**
 * Durable work for the shadow pipeline. Capture writes the job with the message,
 * so a provider outage delays interpretation but never loses a message.
 */
model ProcessingJob {
  id              String          @id @default(cuid())
  stage           ProcessingStage
  message         Message         @relation(fields: [messageId], references: [id])
  messageId       String
  /** Stage, message and pipeline version: a redelivered message never queues twice. */
  idempotencyKey  String          @unique
  pipelineVersion String
  status          JobStatus       @default(pending)
  attempts        Int             @default(0)
  maxAttempts     Int             @default(5)
  runAfter        DateTime        @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  lastErrorKind   FailureKind?
  lastError       String?
  /** The run whose output this job accepted, possibly reused from an identical earlier run. */
  resultRun       InterpretationRun?  @relation("JobResult", fields: [resultRunId], references: [id])
  resultRunId     String?
  runs            InterpretationRun[] @relation("JobRuns")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?

  @@index([status, runAfter])
  @@index([messageId])
}

/**
 * One call to an interpreter or a resolver (see `stage`), kept whether it succeeded or not. A new model or
 * prompt version writes a new run; earlier runs are never rewritten.
 */
model InterpretationRun {
  id                 String          @id @default(cuid())
  job                ProcessingJob?  @relation("JobRuns", fields: [jobId], references: [id])
  jobId              String?
  acceptedBy         ProcessingJob[] @relation("JobResult")
  message            Message         @relation(fields: [messageId], references: [id])
  messageId          String
  stage              ProcessingStage
  pipelineVersion    String
  interpreter        String
  interpreterVersion String
  provider           String?
  model              String?
  promptVersion      String?
  schemaVersion      Int
  inputHash          String
  contextHash        String
  status             RunStatus
  failureKind        FailureKind?
  error              String?
  inputTokens        Int?
  outputTokens       Int?
  costUsd            Float?
  latencyMs          Int
  /** The validated output, as returned, for diagnosis and replay. */
  result             Json?
  observations       Observation[]
  resolutions        ResolutionProposal[]
  createdAt          DateTime        @default(now())

  @@index([messageId, stage])
  @@index([stage, inputHash, contextHash, interpreter, interpreterVersion])
  @@index([createdAt])
}

/** An assertion a run read in a message. Accepted facts are a separate projection. */
model Observation {
  id               String            @id @default(cuid())
  run              InterpretationRun @relation(fields: [runId], references: [id])
  runId            String
  message          Message           @relation(fields: [messageId], references: [id])
  messageId        String
  position         Int
  intent           ObservationIntent
  eventMention     String?
  ticketCategory   String?
  quantity         Int?
  priceAmount      Float?
  priceCurrency    String?
  priceMeaning     String?
  eventYear        Int?
  eventMonth       Int?
  eventDay         Int?
  dateBasis        String?
  /** `[{ start, end, text }]` offsets into the message text, checked before storing. */
  spans            Json
  relationshipKind String?
  relatedMessageId String?
  ambiguities      String[]
  resolutions      ResolutionProposal[]
  createdAt        DateTime          @default(now())

  @@unique([runId, position])
  @@index([messageId])
}

enum ResolutionDecision {
  link
  new_event
  abstain
  not_mentioned
}

/**
 * Which catalog edition an observation is about, as a resolve run proposed it.
 * Shadow output: nothing links a message or a signal from here.
 */
model ResolutionProposal {
  id            String             @id @default(cuid())
  run           InterpretationRun  @relation(fields: [runId], references: [id])
  runId         String
  observation   Observation        @relation(fields: [observationId], references: [id])
  observationId String
  message       Message            @relation(fields: [messageId], references: [id])
  messageId     String
  decision      ResolutionDecision
  /** No foreign key: merging or discarding a party must never be blocked by a proposal. */
  partyId       String?
  /** The shortlist retrieval offered, `[{ partyId, score, reasons }]`, best first. */
  candidates    Json
  reason        String?
  createdAt     DateTime           @default(now())

  @@unique([runId, observationId])
  @@index([messageId])
  @@index([partyId])
}

enum SuggestionKind {
  link
  new_event
  doubt
}

enum ReviewAction {
  linked
  created
  dismissed
  undone
}

/**
 * What the operator did with an orphan while the Inbox showed suggestions, beside
 * what was suggested. Acceptance is read from these, never written into a prompt.
 */
model ProposalReview {
  id               String          @id @default(cuid())
  message          Message         @relation(fields: [messageId], references: [id])
  messageId        String
  action           ReviewAction
  /** No foreign keys to parties, for the same reason as on proposals. */
  chosenPartyId    String?
  /** Null when the message had no resolve run yet. */
  suggestion       SuggestionKind?
  suggestedPartyId String?
  runId            String?
  createdAt        DateTime        @default(now())

  @@index([messageId])
  @@index([createdAt])
}

/** Singleton row (`id = "wa"`) shared by the web board and the connector process. */
model WaSession {
  id            String    @id @default("wa")
  state         WaState   @default(disconnected)
  detail        String?
  qr            String?
  lastMessageAt DateTime?
  heartbeatAt   DateTime?
  updatedAt     DateTime  @updatedAt
}
