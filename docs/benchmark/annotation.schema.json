{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "annotator": {
      "type": "string",
      "minLength": 1
    },
    "annotatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "source": {
      "type": "string",
      "enum": ["human", "model_draft"]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "demand",
              "offer",
              "promotion",
              "update",
              "withdrawal_claim",
              "unrelated",
              "unresolved"
            ]
          },
          "event": {
            "type": "object",
            "properties": {
              "mention": {
                "type": ["string", "null"]
              },
              "partyId": {
                "type": ["string", "null"]
              },
              "resolution": {
                "type": "string",
                "enum": ["resolved", "new_event", "ambiguous", "not_mentioned"]
              }
            },
            "required": ["mention", "partyId", "resolution"],
            "additionalProperties": false
          },
          "ticketCategory": {
            "type": ["string", "null"]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "enum": ["BRL", "other"]
                  },
                  "meaning": {
                    "type": "string",
                    "enum": ["asking", "offered", "official", "paid", "unknown"]
                  }
                },
                "required": ["amount", "currency", "meaning"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "eventDate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "year": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "month": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 12
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "day": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 31
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "enum": ["explicit", "inferred", "absent"]
                  }
                },
                "required": ["year", "month", "day", "basis"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["start", "end", "text"],
              "additionalProperties": false
            }
          },
          "relationship": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "duplicate",
                  "renewed_intent",
                  "price_update",
                  "withdrawal",
                  "unknown"
                ]
              },
              "relatedMessage": {
                "type": ["string", "null"]
              }
            },
            "required": ["kind", "relatedMessage"],
            "additionalProperties": false
          },
          "ambiguities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "intent",
          "event",
          "ticketCategory",
          "quantity",
          "price",
          "eventDate",
          "spans",
          "relationship",
          "ambiguities"
        ],
        "additionalProperties": false
      }
    },
    "needsReview": {
      "type": "boolean"
    },
    "contextUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "annotator",
    "annotatedAt",
    "source",
    "observations",
    "needsReview",
    "contextUsed",
    "notes"
  ],
  "additionalProperties": false
}
